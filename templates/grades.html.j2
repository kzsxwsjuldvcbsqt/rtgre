{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{% for s in sections %}{% if s.id == 'grades' %}{{ s.label }}{% endif %}{% endfor %} - {{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'grades', class_config, section_files.grades, url_for, labels, site) }}{% endblock %}
{% block topbar %}{% call app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar))], (sections | selectattr('id', 'equalto', 'grades') | first).label, labels) %}
<div class="grades-actions" id="grades-actions" role="group" aria-label="{{ labels.grades.actions }}" hidden>
<button type="button" class="btn" id="grades-import-btn">{{ icon('upload', url_for, site.icons) }}<span class="btn-label">{{ labels.grades.import_btn }}</span></button>
<button type="button" class="btn" id="grades-bulletin-btn">{{ icon('file-pdf', url_for, site.icons) }}<span class="btn-label">{{ labels.grades.bulletin_btn }}</span></button>
<input type="file" id="grades-bulletin-file" accept="application/pdf,.pdf" hidden>
<button type="button" class="btn" id="grades-export-btn">{{ icon('download', url_for, site.icons) }}<span class="btn-label">{{ labels.grades.export_btn }}</span></button>
<button type="button" class="btn btn-danger" id="grades-reset-btn">{{ icon('trash', url_for, site.icons) }}<span class="btn-label">{{ labels.grades.reset_btn }}</span></button>
<input type="file" id="grades-import-file" accept=".json" hidden>
</div>
{% endcall %}{% endblock %}
{% block content %}
<div class="page-container grades-page" id="grades-page">
<div class="page-band grades-band">
{% if grades_data.has_details %}
<label class="toggle-pill" for="grades-detail-toggle" id="grades-detail-option" hidden><input type="checkbox" id="grades-detail-toggle">{{ icon('check', url_for, site.icons, 'icon-sm') }}{{ labels.grades.detail_toggle }}</label>
{% endif %}
<label class="toggle-pill" for="grades-coef-toggle" id="grades-coef-option" hidden><input type="checkbox" id="grades-coef-toggle">{{ icon('check', url_for, site.icons, 'icon-sm') }}{{ labels.grades.coef_toggle }}</label>
</div>
<noscript>
<p class="noscript-notice">{{ labels.grades.noscript_notice }}</p>
</noscript>
<p class="privacy-notice">{{ labels.grades.privacy_notice }}<br>{{ labels.grades.bulletin_notice }}</p>
<div id="grades-message" class="grades-message" role="status" aria-live="polite" hidden></div>

<div class="grades-layout">
{% if grades_data.annual_units %}
<aside class="data-box grades-panel" aria-labelledby="grades-summary-title">
<header class="data-box-head"><h2 id="grades-summary-title">{{ labels.grades.annual_synthesis }}</h2></header>
<div class="table-card">
<table class="grades-summary-table">
<thead>
<tr>
<th scope="col"><span class="visually-hidden">{{ labels.grades.unit_column }}</span></th>
{% for sem in grades_data.semesters %}
<th scope="col"><abbr title="{{ sem.label }}">{{ sem.short_label }}</abbr></th>
{% endfor %}
<th scope="col">{{ labels.grades.annual_header_annual }}</th>
</tr>
</thead>
<tbody id="grades-panel-body" hidden>
{% for au in grades_data.annual_units %}
<tr>
<th scope="row"><abbr title="{{ au.label }}">{{ au.short_label }}</abbr></th>
{% for sem in grades_data.semesters %}
<td id="synth-{{ sem.id }}-{{ au.id }}" data-empty-mark="{{ labels.grades.empty_mark }}"></td>
{% endfor %}
<td id="synth-annual-{{ au.id }}" data-empty-mark="{{ labels.grades.empty_mark }}"></td>
</tr>
{% endfor %}
<tr class="grades-summary-total">
<th scope="row">{{ labels.grades.average_column }}</th>
{% for sem in grades_data.semesters %}
<td id="avg-{{ sem.id }}" data-empty-mark="{{ labels.grades.empty_mark }}"></td>
{% endfor %}
<td></td>
</tr>
</tbody>
</table>
<p class="grades-panel-empty" id="grades-panel-empty">{{ labels.grades.panel_empty }}</p>
</div>
</aside>
{% endif %}

<div id="notes-content">
{% for sem in grades_data.semesters %}
<section class="semester-section data-box" id="semester-section-{{ sem.id }}">
<header class="data-box-head">
<h3 class="collapsible-heading">
  <span>{{ sem.label }}</span>
  <button type="button" class="heading-toggle-btn semester-toggle-btn" id="sem-toggle-{{ sem.id }}" aria-expanded="true" aria-label="{{ labels.grades.toggle_semester.format(semester=sem.label) }}" aria-controls="semester-table-{{ sem.id }}">
    <span class="toggle-arrow">{{ icon('chevron-down', url_for, site.icons) }}</span>
  </button>
</h3>
</header>
<div class="table-card">
<table id="semester-table-{{ sem.id }}" class="grades-table" data-semester="{{ sem.id }}">
<thead>
<tr>
<th class="col-module">{{ labels.grades.subject_code }}</th>
{% for u in sem.units %}
<th class="col-coef" scope="col">{{ u.label }}</th>
{% endfor %}
<th class="col-grade-input">{{ grade_label }}</th>
</tr>
</thead>
<tbody>
{% for subj in sem.subjects %}
<tr class="subject-row" data-module-code="{{ subj.code }}">
<td class="col-module">
<span class="module-title"><strong>{{ subj.code }}</strong> - {{ subj.label }}</span>
{% set coef = namespace(units=[]) %}{% for u in sem.units %}{% if subj.coeffs.get(u.id) %}{% set coef.units = coef.units + [u] %}{% endif %}{% endfor %}
<span class="coef-list" aria-hidden="true">{% for u in coef.units %}{% if not loop.first %}<span class="coef-sep">{{ labels.grades.coefficient_separator }}</span>{% endif %}<span class="coef"><span class="coef-unit">{{ u.label }}</span> <strong>{{ subj.coeffs[u.id] }}</strong></span>{% endfor %}</span>
</td>
{% for u in sem.units %}
<td class="col-coef">{{ subj.coeffs.get(u.id) or "" }}</td>
{% endfor %}
<td class="col-grade-input">
<input type="text"
       class="grade-input"
       data-module="{{ subj.code }}"
       placeholder="{{ grade_empty }}"
       inputmode="decimal"
       aria-label="{{ grade_label }} - {{ subj.code }}"
>
{% if subj.evaluations %}
<output class="grade-computed" data-computed-module="{{ subj.code }}" aria-label="{{ labels.grades.computed_grade }} - {{ subj.code }}" hidden></output>
{% endif %}
</td>
</tr>
{% for ev in subj.evaluations %}
<tr class="evaluation-row" data-parent-module="{{ subj.code }}" hidden>
<td class="col-module"><span class="evaluation-name">{{ ev.label }}</span> <span class="evaluation-weight">{{ labels.grades.evaluation_weight.format(weight=ev.weight) }}</span></td>
{% for u in sem.units %}
<td class="col-coef"></td>
{% endfor %}
<td class="col-grade-input">
<input type="text"
       class="grade-input"
       data-evaluation-module="{{ subj.code }}"
       data-evaluation="{{ ev.id }}"
       placeholder="{{ grade_empty }}"
       inputmode="decimal"
       aria-label="{{ grade_label }} - {{ subj.code }} - {{ ev.label }}"
>
</td>
</tr>
{% endfor %}
{% endfor %}
</tbody>
</table>
</div>
</section>
{% endfor %}
</div>
</div>
</div>

<script defer src="{{ url_for('static/js/write-access.js') }}"></script>
<script defer src="{{ url_for('static/js/grades-model.js') }}"></script>
<script defer src="{{ url_for('static/js/bulletin-model.js') }}"></script>
<script defer src="{{ url_for('static/js/grades.js') }}"
  data-class-id="{{ class_config.id }}"
  data-min="{{ site.grades.minimum }}"
  data-max="{{ site.grades.maximum }}"
  data-decimals="{{ site.grades.decimals }}"
  data-message-duration="{{ site.grades.message_duration_ms }}"
  data-mobile-query="{{ mobile_media_query }}"
  data-pass-mark="{{ site.grades.pass_mark }}"
  data-storage-prefix="{{ site.grades.storage_key_prefix }}"
  data-detail-storage-prefix="{{ site.grades.detail_storage_key_prefix }}"
  data-format-version="{{ site.grades.export_format_version }}"
  data-export-format="{{ site.grades.export_format }}"
  data-export-filename="{{ site.grades.export_filename }}"
  data-max-import-bytes="{{ site.grades.max_import_bytes }}"
  data-max-entries="{{ site.grades.max_entries }}"
  data-import-replace-confirm="{{ labels.grades.import_replace_confirm }}"
  data-err-empty-import="{{ labels.grades.err_empty_import }}"
  data-err-storage="{{ labels.grades.err_storage }}"
  data-err-restore="{{ labels.grades.err_restore }}"
  data-err-file-size="{{ labels.grades.err_file_size }}"
  data-reset-confirm="{{ labels.grades.reset_confirm }}"
  data-confirm-other-class="{{ labels.grades.confirm_other_class }}"
  data-err-invalid-json="{{ labels.grades.err_invalid_json }}"
  data-err-bad-format="{{ labels.grades.err_bad_format }}"
  data-err-newer-version="{{ labels.grades.err_newer_version }}"
  data-err-conflict="{{ labels.grades.err_conflict }}"
  data-import-success="{{ labels.grades.import_success }}"
  data-entries-ignored="{{ labels.grades.entries_ignored }}"
  data-grades-config='{{ grades_data | tojson }}'
  data-bulletin-config='{{ site.grades.bulletin | tojson }}'
  data-pdfjs="{{ url_for('static/vendor/pdfjs/pdf.min.mjs') }}"
  data-pdfjs-worker="{{ url_for('static/vendor/pdfjs/pdf.worker.min.mjs') }}"
  data-bulletin-reading="{{ labels.grades.bulletin_reading }}"
  data-err-bulletin-unreadable="{{ labels.grades.err_bulletin_unreadable }}"
  data-err-bulletin-not-recognized="{{ labels.grades.err_bulletin_not_recognized }}"
  data-err-bulletin-track="{{ labels.grades.err_bulletin_track }}"
  data-err-bulletin-status="{{ labels.grades.err_bulletin_status }}"
  data-err-bulletin-modules="{{ labels.grades.err_bulletin_modules }}"
  data-err-bulletin-empty="{{ labels.grades.err_bulletin_empty }}"
  data-bulletin-replace-confirm="{{ labels.grades.bulletin_replace_confirm }}"
  data-bulletin-success="{{ labels.grades.bulletin_success }}"
></script>
{% endblock %}
