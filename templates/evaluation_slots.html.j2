{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ slots[0].summary }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'evaluations', class_config, section_files.evaluations, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar)), ((sections | selectattr('id', 'equalto', 'evaluations') | first).label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.evaluations))], slots[0].summary, labels, url_for, site, class_config.label) }}{% endblock %}
{% block content %}
<div class="page-container">
<p>{{ labels.evaluation_page.choose_slot }}</p>
<section class="data-box">
<ul class="box-list">
{% for ev in slots %}
<li><a class="box-row" href="{{ url_for('classes/' ~ class_config.id ~ '/evaluations/' ~ ev.occurrence_id ~ '.html') }}"><span class="box-row-main">{{ long_date(ev.start_dt) }}{{ labels.evaluation_page.slot_separator }}{{ ev.time_range }}</span>{{ icon('chevron-right', site.icons, 'box-row-icon') }}</a></li>
{% endfor %}
</ul>
</section>
<p><a href="{{ url_for('classes/' ~ class_config.id ~ '/' ~ section_files.evaluations) }}">{{ labels.evaluation_page.back_link }}</a></p>
</div>
{% endblock %}
