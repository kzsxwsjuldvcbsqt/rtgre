{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ slots[0].summary }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'evaluations', class_config, section_files.evaluations, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.home)), ((sections | selectattr('id', 'equalto', 'evaluations') | first).label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.evaluations))], slots[0].summary, labels) }}{% endblock %}
{% block content %}
<div class="page-container">
<p>{{ labels.evaluation_page.choose_slot }}</p>
<section class="data-box">
<ul class="resource-list">
{% for ev in slots %}
<li><a href="{{ url_for('classes/' ~ class_config.id ~ '/evaluations/' ~ ev.occurrence_id ~ '.html') }}">{{ ev.date_formatted }} — {{ ev.time_range }}</a>{{ icon('chevron-right', url_for, site.icons, 'list-chevron') }}</li>
{% endfor %}
</ul>
</section>
<p><a href="{{ url_for('classes/' ~ class_config.id ~ '/' ~ section_files.evaluations) }}">{{ labels.evaluation_page.back_link }}</a></p>
</div>
{% endblock %}
