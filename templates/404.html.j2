{% from "_icons.html.j2" import icon %}
<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="{{ content_security_policy }}">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% for icon in favicons %}
<link rel="{{ icon.rel }}"{% if icon.type %} type="{{ icon.type }}"{% endif %} href="{{ get_404_url('static/' ~ icon.filename) }}">
{% endfor %}
<title>{{ labels.page_404.title }} - {{ site.title }}</title>
<link rel="stylesheet" href="{{ get_404_url('static/css/style.css') }}">
</head>
<body class="app">
<aside class="app-sidebar">
<div class="app-sidebar-head">
<p class="app-brand">{{ icon('mortar-board', get_404_url, site.icons) }}<span>{{ site.title }}</span></p>
</div>
</aside>
<div class="app-main">
<header class="app-topbar">
<h1>{{ labels.page_404.title }}</h1>
</header>
<main class="site-main">
<div class="page-container">
<p>{{ labels.page_404.description }}</p>
<p><a href="{{ get_404_url('index.html') }}">{{ labels.page_404.home_link }}</a></p>
</div>
</main>
<footer class="app-footnote">
<span>{{ site.subtitle }}{{ labels.list_separator }}{{ labels.unofficial_notice }}</span>
<span>{{ labels.footer.generated_at }} {{ generated_at }}</span>
</footer>
</div>
</body>
</html>
