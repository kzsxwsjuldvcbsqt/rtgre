<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% for icon in favicons %}
<link rel="{{ icon.rel }}"{% if icon.type %} type="{{ icon.type }}"{% endif %} href="{{ url_for('static/' ~ icon.filename) }}">
{% endfor %}
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<link rel="stylesheet" href="{{ url_for('static/style.css') }}">
<script src="{{ url_for('static/utils.js') }}"></script>
</head>
<body class="{% if page_wide %}page-wide{% endif %}">
<header class="site-header">
<div class="header-container">
<div class="header-titles">
<div class="site-title">{{ site.title }}</div>
<div class="site-subtitle"><span class="subtitle-text">{{ site.subtitle }}</span><span class="subtitle-sep">{{ labels.list_separator }}</span><span class="subtitle-unofficial">{{ labels.unofficial_notice }}</span></div>
</div>
{% if class_config is defined and class_config %}
<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="section-nav-menu" aria-label="{{ labels.sections.menu_toggle }}">
<span class="burger-bar"></span>
<span class="burger-bar"></span>
<span class="burger-bar"></span>
</button>
{% endif %}
</div>
</header>
<main class="site-main">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
<div class="footer-container">
<span>{{ labels.footer.generated_at }} {{ generated_at }}</span>
</div>
</footer>
<script src="{{ url_for('static/filters.js') }}"></script>
</body>
</html>
