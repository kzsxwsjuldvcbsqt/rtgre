{% from "_icons.html.j2" import icon %}
<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="{{ content_security_policy }}">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% for icon in favicons %}
<link rel="{{ icon.rel }}"{% if icon.type %} type="{{ icon.type }}"{% endif %} href="{{ url_for('static/' ~ icon.filename) }}">
{% endfor %}
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<link rel="stylesheet" href="{{ url_for('static/css/style.css') }}">
<script src="{{ url_for('static/js/boot.js') }}"></script>
{% if class_config is defined and class_config %}
<script src="{{ url_for('static/js/remember-class.js') }}" data-remember-class="{{ class_config.id }}"></script>
{% endif %}
<script defer src="{{ url_for('static/js/utils.js') }}"></script>
<script defer src="{{ url_for('static/js/menu.js') }}"></script>
{% block head_scripts %}{% endblock %}
</head>
<body class="app">
{% block sidebar %}{% endblock %}
<div class="app-main">
{% block topbar %}{% endblock %}
<main class="site-main">
{% block content %}{% endblock %}
</main>
<footer class="app-footnote">
<span>{{ site.subtitle }}{{ labels.list_separator }}{{ labels.unofficial_notice }}</span>
<span>{{ labels.footer.generated_at }} {{ generated_at }}</span>
</footer>
</div>
{% block scripts %}{% endblock %}
</body>
</html>
