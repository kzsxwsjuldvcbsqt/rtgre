{% from "_icons.html.j2" import icon %}
<!DOCTYPE html>
<html lang="{{ site.language }}"{% if theme_id %} data-theme="{{ theme_id }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="{{ content_security_policy }}">
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% for icon in favicons %}
<link rel="{{ icon.rel }}"{% if icon.type %} type="{{ icon.type }}"{% endif %} href="{{ url_for('static/' ~ icon.filename) }}">
{% endfor %}
<title>{% block title %}{{ site.title }}{% endblock %}</title>
{% for font in site.preload_fonts %}
<link rel="preload" as="font" type="font/woff2" href="{{ url_for('static/' ~ font) }}" crossorigin>
{% endfor %}
{% for image in theme_preload_images %}
<link rel="preload" as="image" href="{{ url_for('static/' ~ image) }}">
{% endfor %}
<link rel="stylesheet" href="{{ url_for('static/' ~ site.stylesheet) }}">
{% if theme_stylesheet %}
<link rel="stylesheet" href="{{ url_for('static/' ~ theme_stylesheet) }}">
{% endif %}
<script src="{{ url_for('static/js/boot.js') }}"></script>
{% if class_config is defined and class_config %}
<script src="{{ url_for('static/js/remember-class.js') }}" data-remember-class="{{ class_config.id }}"></script>
{% endif %}
<script defer src="{{ url_for('static/js/utils.js') }}"
  data-language="{{ site.language }}"
  data-timezone="{{ site.timezone }}"
  data-soon-days="{{ site.evaluations.soon_days }}"
  data-relative-days-max="{{ site.evaluations.relative_days_max }}"
  data-relative-weeks-max="{{ site.evaluations.relative_weeks_max }}"
></script>
<script defer src="{{ url_for('static/js/menu.js') }}"></script>
{% block head_scripts %}{% endblock %}
<script defer src="{{ url_for('static/js/mobile-shell.js') }}"
  data-icon-close="#{{ site.icons.id_prefix }}x"
  data-label-filters="{{ labels.sections.filters_title }}"
  data-label-close="{{ labels.sections.filters_close }}"
  data-label-apply="{{ labels.sections.filters_apply }}"
  data-label-apply-empty="{{ labels.sections.filters_apply_empty }}"
></script>
</head>
<body class="app">
{% include icon_sprite_template %}
{% block sidebar %}{% endblock %}
<div class="app-main">
{% block topbar %}{% endblock %}
<main class="site-main">
<p class="stale-notice" role="alert" hidden data-generated-at="{{ generated_iso }}" data-stale-hours="{{ site.stale_after_hours }}" data-message="{{ labels.footer.stale_notice }}"></p>
{% block content %}{% endblock %}
</main>
<footer class="app-footnote">
<span>{{ site.subtitle }}{{ labels.list_separator }}{{ labels.unofficial_notice }}</span>
<span>{{ labels.footer.generated_at }} {{ generated_at }}</span>
</footer>
</div>
<div class="app-backdrop" hidden></div>
{% block scripts %}{% endblock %}
</body>
</html>
