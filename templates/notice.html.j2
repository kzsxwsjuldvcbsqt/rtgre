{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ labels.notice.title }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'notice', none, none, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([], labels.notice.title, labels) }}{% endblock %}
{% block content %}
<div class="page-container">
<div class="text-block">
<p>{{ labels.notice.p1 }}</p>
<p>{{ labels.notice.p2 }}</p>
<p>{{ labels.notice.p3 }}</p>
<p>{{ labels.notice.p4 }}</p>
<p>{{ labels.notice.p5 }}</p>
<p>{{ labels.notice.p6 }}</p>
<p>{{ labels.notice.p7 }} <a href="{{ site.github_url }}" target="_blank" rel="noopener noreferrer" class="external-link">{{ site.github_profile }}{{ icon('link-external', url_for, site.icons, 'icon-sm') }}</a>.</p>
</div>
</div>
{% endblock %}
