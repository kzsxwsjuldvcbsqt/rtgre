{% extends "base.html.j2" %}
{% from "_feeds.html.j2" import feed_choices %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ labels.notice.title }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'notice', class_config, section_files.notice, url_for, labels, site) }}{% endblock %}
{% block topbar %}{% if class_config %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar))], labels.notice.title, labels, url_for, site, class_config.label) }}{% else %}{{ app_topbar([(labels.index.heading, url_for('index.html'))], labels.notice.title, labels, url_for, site) }}{% endif %}{% endblock %}
{% block head_scripts %}
<script defer src="{{ url_for('static/js/appearance.js') }}"></script>
<script defer src="{{ url_for('static/js/feeds.js') }}"></script>
{% endblock %}
{% block content %}
<div class="page-container">
<section class="data-box">
<header class="data-box-head"><h2>{{ labels.notice.settings_title }}</h2></header>
<ul class="box-list">
<li class="box-row setting-row js-only">
<span class="box-row-main"><span class="setting-name" id="appearance-label">{{ labels.notice.appearance }}</span><span class="setting-help">{{ labels.notice.appearance_help }}</span></span>
<div class="segmented" role="group" aria-labelledby="appearance-label" data-color-scheme-choice>
<button type="button" class="segmented-option" data-value="auto" aria-pressed="false">{{ labels.notice.scheme_auto }}</button>
<button type="button" class="segmented-option" data-value="light" aria-pressed="false">{{ labels.notice.scheme_light }}</button>
<button type="button" class="segmented-option" data-value="dark" aria-pressed="false">{{ labels.notice.scheme_dark }}</button>
</div>
</li>
{% if class_config %}
<li class="box-row setting-row" id="agenda">
<span class="box-row-main"><span class="setting-name">{{ labels.feeds.row_all }}</span><span class="setting-help">{{ labels.feeds.row_all_help }}</span></span>
{{ feed_choices(site.feeds.calendar_file, labels, site) }}
</li>
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name">{{ labels.feeds.row_evaluations }}</span><span class="setting-help">{{ labels.feeds.row_evaluations_help }}</span></span>
{{ feed_choices(site.feeds.evaluations_file, labels, site) }}
</li>
{% endif %}
</ul>
</section>
<h2>{{ labels.notice.about_title }}</h2>
<div class="text-block">
<p>{{ labels.notice.p1 }}</p>
<p>{{ labels.notice.p2 }}</p>
<p>{{ labels.notice.p3 }}</p>
<p>{{ labels.notice.p4 }}</p>
<p>{{ labels.notice.p5 }}</p>
<p>{{ labels.notice.p6 }}</p>
<p>{{ labels.notice.p7 }} <a href="{{ site.github_url }}" target="_blank" rel="noopener noreferrer" class="external-link">{{ site.github_profile }}{{ icon('link-external', site.icons, 'icon-sm') }}</a>.</p>
<p>{{ labels.notice.feedback }} <a href="{{ site.feedback_url }}" target="_blank" rel="noopener noreferrer" class="external-link">{{ labels.notice.feedback_link }}{{ icon('link-external', site.icons, 'icon-sm') }}</a>.</p>
</div>
</div>
{% endblock %}
