{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'home', class_config, section_files.home, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([], class_config.label, labels) }}{% endblock %}
{% block head_scripts %}
<script defer src="{{ url_for('static/js/calendar-model.js') }}"></script>
<script defer src="{{ url_for('static/js/grades-model.js') }}"></script>
<script defer src="{{ url_for('static/js/dashboard.js') }}"></script>
{% endblock %}
{% block content %}
{% set class_root = 'classes/' ~ class_config.id ~ '/' %}
<div class="page-container">
<noscript>
<p class="noscript-notice">{{ labels.dashboard.noscript }}</p>
</noscript>
<div class="dashboard">
<section class="dashboard-panel" aria-labelledby="dashboard-courses-title">
<header class="dashboard-panel-head">
<h2 id="dashboard-courses-title">{{ labels.dashboard.today }}</h2>
<a href="{{ url_for(class_root ~ section_files.calendar) }}">{{ labels.dashboard.see_calendar }}{{ icon('chevron-right', url_for, site.icons, 'icon-sm') }}</a>
</header>
<div class="dashboard-panel-body" id="dashboard-courses"></div>
</section>
<section class="dashboard-panel" aria-labelledby="dashboard-evaluation-title">
<header class="dashboard-panel-head">
<h2 id="dashboard-evaluation-title">{{ labels.dashboard.next_evaluation }}</h2>
<a href="{{ url_for(class_root ~ section_files.evaluations) }}">{{ labels.dashboard.see_evaluations }}{{ icon('chevron-right', url_for, site.icons, 'icon-sm') }}</a>
</header>
<div class="dashboard-panel-body" id="dashboard-evaluation" data-detail-base="{{ url_for(class_root ~ 'evaluations') }}"></div>
</section>
<section class="dashboard-panel" aria-labelledby="dashboard-grades-title">
<header class="dashboard-panel-head">
<h2 id="dashboard-grades-title">{{ labels.dashboard.averages }}</h2>
<a href="{{ url_for(class_root ~ section_files.grades) }}">{{ labels.dashboard.see_grades }}{{ icon('chevron-right', url_for, site.icons, 'icon-sm') }}</a>
</header>
<div class="dashboard-panel-body" id="dashboard-grades"></div>
</section>
</div>
</div>
<script type="application/json" id="dashboard-data">{{ dashboard_payload | tojson }}</script>
{% endblock %}
