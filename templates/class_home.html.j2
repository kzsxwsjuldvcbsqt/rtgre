{% extends "base.html.j2" %}
{% from "_nav.html.j2" import section_nav %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ class_config.label }} - {{ site.title }}{% endblock %}
{% block subnav %}{{ section_nav(sections, 'home', class_config, url_for, labels, site.icons) }}{% endblock %}
{% block content %}
<div class="page-container">
<div class="back-navigation">
<a href="{{ url_for('index.html') }}">{{ labels.class_page.back_link }}</a>
</div>

<h1>{{ class_config.label }}</h1>

<ul class="class-sections-list">
{% for sec in sections %}
  {% if sec.id != 'home' and sec.kind != 'global' %}
    <li class="section-item">
      {% if sec.kind == 'internal' %}
        {% set sec_target = 'classes/' ~ class_config.id ~ '/' ~ sec.file %}
        <a href="{{ url_for(sec_target) }}"><span class="section-item-text"><strong>{{ sec.label }}</strong><span class="section-desc">{{ labels.class_home.descriptions[sec.id] }}</span></span>{{ icon('chevron-right', url_for, site.icons, 'list-chevron') }}</a>
      {% elif sec.kind == 'external' %}
        <a href="{{ sec.url }}" target="_blank" rel="noopener noreferrer" class="nav-external"><span class="section-item-text"><strong>{{ sec.label }}</strong><span class="section-desc">{{ labels.class_home.descriptions[sec.id] }}</span></span>{{ icon('link-external', url_for, site.icons, 'list-chevron') }}</a>
      {% endif %}
    </li>
  {% endif %}
{% endfor %}
</ul>
</div>
{% endblock %}
