{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{% for s in sections %}{% if s.id == 'evaluations' %}{{ s.label }}{% endif %}{% endfor %} - {{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'evaluations', class_config, section_files.evaluations, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar))], (sections | selectattr('id', 'equalto', 'evaluations') | first).label, labels, url_for, site, class_config.label) }}{% endblock %}
{% block head_scripts %}
<script defer src="{{ url_for('static/js/filters.js') }}"></script>
<script defer src="{{ url_for('static/js/filter-controls.js') }}" data-sprite="{{ url_for('static/' ~ site.icons.sprite) }}"></script>
{% endblock %}
{% block content %}
<div class="page-container has-filter-sidebar">
<div class="filter-sidebar">
<div class="filter-quick">
<div class="filter-quick-slot" id="eval-count-slot"></div>
<button type="button" class="filters-toggle" aria-expanded="false" aria-controls="filters-container" aria-label="{{ labels.calendar.toggle_controls }}">{{ icon('filter', url_for, site.icons) }}</button>
</div>
<div id="filters-container" class="filter-panel" data-sheet-count="results-count"
  data-label-filters-heading="{{ labels.class_page.filters_heading }}"
  data-label-category="{{ labels.class_page.category_filter }}"
  data-label-module="{{ labels.class_page.module_filter }}"
  data-label-module-all="{{ labels.class_page.module_all }}"
  data-label-module-separator="{{ labels.class_page.module_separator }}"
  data-label-module-search="{{ labels.class_page.module_search }}"
  data-label-module-empty="{{ labels.class_page.module_search_empty }}"
  data-label-period="{{ labels.class_page.period_filter }}"
  data-label-reset="{{ labels.class_page.reset_filters }}"
  data-label-singular="{{ labels.class_page.results_count_singular }}"
  data-label-plural="{{ labels.class_page.results_count_plural }}"
  data-label-empty="{{ labels.class_page.empty_state }}"
  data-label-upcoming="{{ labels.periods.upcoming }}"
  data-label-past="{{ labels.periods.past }}"
  data-label-all="{{ labels.periods.all }}"
  data-categories='{{ active_categories | tojson }}'
  data-modules='{{ active_modules | tojson }}'
  data-icon-check="{{ url_for('static/' ~ site.icons.sprite) }}#check"
  data-icon-reset="{{ url_for('static/' ~ site.icons.sprite) }}#x"
></div>
</div>

<div class="section-main">
<div id="evaluations-list">
{% for month_key, month_label, month_evals in months_grouped %}
<section class="month-card data-box" data-month="{{ month_key }}">
<header class="data-box-head"><h3>{{ month_label }}</h3><span class="data-box-meta">{{ month_evals | length }}</span></header>
<ul class="box-list">
{% for ev in month_evals %}
<li class="eval-row" data-category="{{ ev.category_id }}" data-module="{{ ev.module_code | canonical_code }}" data-date="{{ ev.date_iso }}" data-end-timestamp="{{ ev.end_dt.timestamp() | int }}" data-past="{{ 'true' if ev.is_past else 'false' }}">
<a class="box-row eval-link" href="{{ url_for('classes/' ~ ev.class_id ~ '/evaluations/' ~ ev.occurrence_id ~ '.html') }}">
<span class="eval-date"><span class="eval-day">{{ short_date(ev.start_dt) }}</span><span class="eval-delay"></span></span>
<span class="eval-time">{{ ev.time_range }}</span>
<span class="eval-module"><strong>{{ ev.module_code | canonical_code }}</strong>{% if module_labels.get(ev.module_code) %} - {{ module_labels[ev.module_code] }}{% endif %}</span>
<span class="category-badge{% if category_tones.get(ev.category_id) %} label-{{ category_tones[ev.category_id] }}{% endif %}">{{ ev.category_label }}</span>
{{ icon('chevron-right', url_for, site.icons, 'box-row-icon') }}
</a>
</li>
{% endfor %}
</ul>
</section>
{% endfor %}
</div>

<div id="empty-state-message" class="empty-state-message" hidden>
{{ labels.class_page.empty_state }}
</div>
</div>
</div>
{% endblock %}
