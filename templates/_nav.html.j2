{% from "_icons.html.j2" import icon %}
{% macro app_sidebar(sections, current_id, class_config, switch_file, url_for, labels, site) %}
<aside class="app-sidebar" id="app-sidebar">
<div class="app-sidebar-head">
<p class="app-brand">{{ site.title }}</p>
<button type="button" class="nav-close" aria-label="{{ labels.sections.menu_close }}">{{ icon('x', site.icons) }}</button>
</div>
<nav class="app-nav" aria-label="{{ labels.sections.navigation }}">
{% if class_config %}
<ul class="nav-menu">
{% for sec in sections %}
{% if sec.kind == 'internal' %}
<li><a href="{{ url_for('classes/' ~ class_config.id ~ '/' ~ sec.file) }}"{% if sec.id == current_id %} aria-current="page"{% endif %}>{{ icon(sec.icon ~ (site.icons.current_suffix if sec.id == current_id else ''), site.icons) }}<span>{{ sec.label }}</span></a></li>
{% endif %}
{% endfor %}
</ul>
{% endif %}
{% if class_config %}
<p class="app-nav-heading">{{ labels.sections.classes_heading }}</p>
{% for prog in programs %}
<ul class="app-nav-classes" aria-label="{{ prog.label }}">
{% for cls in prog.classes %}
<li><a href="{{ url_for('classes/' ~ cls.id ~ '/' ~ switch_file) }}"{% if cls.id == class_config.id %} aria-current="page"{% endif %}><span>{{ cls.label }}</span></a></li>
{% endfor %}
</ul>
{% endfor %}
{% endif %}
<p class="app-nav-heading">{{ labels.sections.external_heading }}</p>
<ul class="app-nav-links">
{% for sec in sections %}
{% if sec.kind == 'external' %}
<li><a href="{{ sec.url }}" target="_blank" rel="noopener noreferrer" class="nav-external" data-umami-event="Lien externe" data-umami-event-cible="{{ sec.label }}"><span>{{ sec.label }}</span>{{ icon('link-external', site.icons, 'icon-sm') }}</a></li>
{% endif %}
{% endfor %}
</ul>
<ul class="app-nav-foot">
{% if class_config %}
<li class="nav-agenda"><a href="{{ url_for('classes/' ~ class_config.id ~ '/' ~ section_files.settings) }}#agenda">{{ icon('plus', site.icons) }}<span>{{ labels.feeds.add_btn }}</span></a></li>
{% endif %}
{% for sec in sections %}
{% if sec.kind == 'global' %}
<li><a href="{{ url_for(('classes/' ~ class_config.id ~ '/' if class_config else '') ~ sec.file) }}"{% if sec.id == current_id %} aria-current="page"{% endif %}>{{ icon(sec.icon ~ (site.icons.current_suffix if sec.id == current_id else ''), site.icons) }}<span>{{ sec.label }}</span></a></li>
{% endif %}
{% endfor %}
</ul>
</nav>
</aside>
{% endmacro %}

{% macro app_topbar(trail, title, labels, url_for, site, class_label='') %}
<div class="app-topbar">
<header class="app-topbar-main">
<button type="button" class="nav-toggle nav-burger" aria-controls="app-sidebar" aria-expanded="false" aria-label="{{ labels.sections.menu_open }}">{{ icon('three-bars', site.icons) }}</button>
<nav class="app-breadcrumb" aria-label="{{ labels.sections.breadcrumb }}">
<ol>
{% for label, href in trail %}
<li><a href="{{ href }}">{{ label }}</a></li>
{% endfor %}
<li><h1>{{ title }}</h1></li>
</ol>
</nav>
{% if class_label %}
<span class="nav-class-chip">{{ class_label }}</span>
{% endif %}
</header>
{% if caller is defined %}
<div class="app-topbar-actions">{{ caller() }}</div>
{% endif %}
</div>
{% endmacro %}
