{% from "_icons.html.j2" import icon %}
{% macro section_nav(sections, current_id, class_config, url_for, labels, icons) %}
<nav class="section-nav" aria-label="{{ labels.sections.navigation }}">
<div class="section-nav-inner">
<div class="nav-menu">
{% for sec in sections %}
{% if sec.kind == 'internal' %}
{% set sec_target = 'classes/' ~ class_config.id ~ '/' ~ sec.file %}
{% set is_active = (sec.id == current_id) %}
<a href="{{ url_for(sec_target) }}"{% if is_active %} aria-current="page" class="nav-active"{% endif %}>{{ sec.label }}</a>
{% elif sec.kind == 'external' %}
<a href="{{ sec.url }}" target="_blank" rel="noopener noreferrer" class="nav-external">{{ sec.label }}{{ icon('link-external', url_for, icons, 'icon-sm') }}</a>
{% endif %}
{% endfor %}
</div>
</div>
</nav>
{% endmacro %}
