{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{% for s in sections %}{% if s.id == 'resources' %}{{ s.label }}{% endif %}{% endfor %} - {{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'resources', class_config, section_files.resources, url_for, labels, site) }}{% endblock %}
{% block topbar %}{% call app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar))], (sections | selectattr('id', 'equalto', 'resources') | first).label, labels, url_for, site, class_config.label) %}<a class="btn" href="{{ site.chamilo.space_url }}" target="_blank" rel="noopener noreferrer">{{ labels.resources.chamilo_space }}{{ icon('link-external', site.icons, 'icon-sm') }}</a>{% endcall %}{% endblock %}
{% block content %}
<div class="page-container">
{% for group in module_groups %}
<details class="data-box module-group"{% if group.open %} open{% endif %}>
<summary class="data-box-head"><h2>{{ group.label }}</h2>{{ icon('chevron-down', site.icons, 'module-group-arrow') }}</summary>
<ul class="box-list">
{% for mod in group.modules %}
{% set show_code = mod.code != mod.label and mod.get("show_code", true) %}
{% set name %}<span class="box-row-main">{% if show_code %}<strong>{{ mod.code }}</strong> - {{ mod.label }}{% else %}<strong>{{ mod.label }}</strong>{% endif %}</span>{% endset %}
<li>
{% if mod.chamilo_url %}
<a class="box-row" href="{{ mod.chamilo_url }}" target="_blank" rel="noopener noreferrer" data-umami-event="Lien externe" data-umami-event-cible="Chamilo">{{ name }}{{ icon('link-external', site.icons, 'box-row-icon') }}</a>
{% else %}
<div class="box-row">{{ name }}</div>
{% endif %}
</li>
{% endfor %}
</ul>
</details>
{% endfor %}
</div>
{% endblock %}
