{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_icons.html.j2" import icon %}
{% block title %}{% for s in sections %}{% if s.id == 'resources' %}{{ s.label }}{% endif %}{% endfor %} - {{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'resources', class_config, section_files.resources, url_for, labels, site) }}{% endblock %}
{% block topbar %}{% call app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.home))], (sections | selectattr('id', 'equalto', 'resources') | first).label, labels) %}<a class="btn" href="{{ site.chamilo.space_url }}" target="_blank" rel="noopener noreferrer">{{ labels.resources.chamilo_space }}{{ icon('link-external', url_for, site.icons, 'icon-sm') }}</a>{% endcall %}{% endblock %}
{% block content %}
<div class="page-container">
{% for sem_info, kinds_grouped in resource_groups %}
<h2>{{ sem_info.label }}</h2>
{% for kind_info, modules in kinds_grouped %}
{% if kind_info.label %}
<h3>{{ kind_info.label }}</h3>
{% endif %}
<ul class="resource-list">
{% for mod in modules %}
<li>
{% if mod.chamilo_url %}
<a href="{{ mod.chamilo_url }}" target="_blank" rel="noopener noreferrer">{% if mod.code == mod.label or not mod.get("show_code", true) %}<strong>{{ mod.label }}</strong>{% else %}<strong>{{ mod.code }}</strong> - {{ mod.label }}{% endif %}</a>{{ icon('link-external', url_for, site.icons, 'list-chevron') }}
{% else %}
<span>{% if mod.code == mod.label or not mod.get("show_code", true) %}<strong>{{ mod.label }}</strong>{% else %}<strong>{{ mod.code }}</strong> - {{ mod.label }}{% endif %}</span>
{% endif %}
</li>
{% endfor %}
</ul>
{% endfor %}
{% endfor %}
</div>
{% endblock %}
