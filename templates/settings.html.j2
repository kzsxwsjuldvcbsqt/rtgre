{% extends "base.html.j2" %}
{% from "_feeds.html.j2" import feed_choices %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% block title %}{{ labels.settings.title }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'settings', class_config, section_files.settings, url_for, labels, site) }}{% endblock %}
{% block topbar %}{% if class_config %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar))], labels.settings.title, labels, url_for, site, class_config.label) }}{% else %}{{ app_topbar([(labels.index.heading, url_for('index.html'))], labels.settings.title, labels, url_for, site) }}{% endif %}{% endblock %}
{% block head_scripts %}
<script defer src="{{ url_for('static/js/appearance.js') }}"></script>
<script defer src="{{ url_for('static/js/feeds.js') }}"></script>
{% endblock %}
{% block content %}
<div class="page-container">
<section class="data-box js-only">
<header class="data-box-head"><h2>{{ labels.settings.appearance_title }}</h2></header>
<ul class="box-list">
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name" id="mode-label">{{ labels.settings.mode }}</span><span class="setting-help">{{ labels.settings.mode_help }}</span></span>
<div class="segmented" role="group" aria-labelledby="mode-label" data-color-scheme-choice>
<button type="button" class="segmented-option" data-value="auto" aria-pressed="false" data-umami-event="Apparence" data-umami-event-choix="automatique">{{ labels.settings.scheme_auto }}</button>
<button type="button" class="segmented-option" data-value="light" aria-pressed="false" data-umami-event="Apparence" data-umami-event-choix="clair">{{ labels.settings.scheme_light }}</button>
<button type="button" class="segmented-option" data-value="dark" aria-pressed="false" data-umami-event="Apparence" data-umami-event-choix="sombre">{{ labels.settings.scheme_dark }}</button>
</div>
</li>
{% if themes %}
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name" id="theme-label">{{ labels.settings.theme }}</span><span class="setting-help">{{ labels.settings.theme_help.format(theme=seasonal_theme.label if seasonal_theme else labels.settings.theme_classic) }}</span></span>
<div class="theme-choices" role="group" aria-labelledby="theme-label" data-theme-choice>
<button type="button" class="theme-choice" data-value="{{ theme_choices.seasonal }}" aria-pressed="false" data-umami-event="Thème" data-umami-event-choix="{{ labels.settings.theme_seasonal | lower }}"><span class="theme-swatch" data-swatch="{{ seasonal_theme.id if seasonal_theme else theme_choices.classic }}"></span>{{ labels.settings.theme_seasonal }}</button>
<button type="button" class="theme-choice" data-value="{{ theme_choices.classic }}" aria-pressed="false" data-umami-event="Thème" data-umami-event-choix="{{ labels.settings.theme_classic | lower }}"><span class="theme-swatch" data-swatch="{{ theme_choices.classic }}"></span>{{ labels.settings.theme_classic }}</button>
{% for theme in themes %}
<button type="button" class="theme-choice" data-value="{{ theme.id }}" aria-pressed="false" data-umami-event="Thème" data-umami-event-choix="{{ theme.label | lower }}"><span class="theme-swatch" data-swatch="{{ theme.id }}"></span>{{ theme.label }}</button>
{% endfor %}
</div>
</li>
{% endif %}
</ul>
</section>
{% if class_config %}
<section class="data-box" id="agenda">
<header class="data-box-head"><h2>{{ labels.settings.agenda_title }}</h2></header>
<ul class="box-list">
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name">{{ labels.feeds.row_all }}</span><span class="setting-help">{{ labels.feeds.row_all_help }}</span></span>
{{ feed_choices(site.feeds.calendar_file, labels, site) }}
</li>
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name">{{ labels.feeds.row_evaluations }}</span><span class="setting-help">{{ labels.feeds.row_evaluations_help }}</span></span>
{{ feed_choices(site.feeds.evaluations_file, labels, site) }}
</li>
</ul>
</section>
{% endif %}
{% if 'audience' in site %}
<section class="data-box js-only" id="audience">
<header class="data-box-head"><h2>{{ labels.settings.privacy_title }}</h2></header>
<ul class="box-list">
<li class="box-row setting-row">
<span class="box-row-main"><span class="setting-name" id="audience-label">{{ labels.settings.audience }}</span><span class="setting-help">{{ labels.settings.audience_help }}</span></span>
<div class="segmented" role="group" aria-labelledby="audience-label" data-audience-choice>
<button type="button" class="segmented-option" data-value="counted" aria-pressed="false" data-umami-event="Mesure d'audience" data-umami-event-choix="acceptée">{{ labels.settings.audience_counted }}</button>
<button type="button" class="segmented-option" data-value="refused" aria-pressed="false">{{ labels.settings.audience_refused }}</button>
</div>
</li>
</ul>
</section>
{% endif %}
<section class="data-box shortcuts-box">
<header class="data-box-head"><h2>{{ labels.shortcuts.title }}</h2></header>
<ul class="box-list">
<li class="box-row"><span class="shortcut-keys"><kbd>{{ labels.shortcuts.previous_key }}</kbd><kbd>{{ labels.shortcuts.next_key }}</kbd></span><span class="box-row-main">{{ labels.shortcuts.previous }}, {{ labels.shortcuts.next | lower }}</span></li>
<li class="box-row"><span class="shortcut-keys"><kbd>{{ site.shortcuts.today | upper }}</kbd></span><span class="box-row-main">{{ labels.shortcuts.today }}</span></li>
<li class="box-row"><span class="shortcut-keys"><kbd>{{ site.shortcuts.reset | upper }}</kbd></span><span class="box-row-main">{{ labels.shortcuts.reset }}</span></li>
<li class="box-row"><span class="shortcut-keys"><kbd>{{ site.shortcuts.search | upper }}</kbd></span><span class="box-row-main">{{ labels.shortcuts.search }}</span></li>
</ul>
</section>
</div>
{% endblock %}
