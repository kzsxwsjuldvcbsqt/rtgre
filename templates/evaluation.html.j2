{% extends "base.html.j2" %}
{% from "_nav.html.j2" import app_sidebar, app_topbar %}
{% from "_evaluation_table.html.j2" import evaluation_table_header, evaluation_row %}
{% from "_icons.html.j2" import icon %}
{% block title %}{{ evaluation.summary }} - {{ class_config.label }} - {{ site.title }}{% endblock %}
{% block sidebar %}{{ app_sidebar(sections, 'evaluations', class_config, section_files.evaluations, url_for, labels, site) }}{% endblock %}
{% block topbar %}{{ app_topbar([(class_config.label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.calendar)), ((sections | selectattr('id', 'equalto', 'evaluations') | first).label, url_for('classes/' ~ class_config.id ~ '/' ~ section_files.evaluations))], evaluation.summary, labels, url_for, site, class_config.label) }}{% endblock %}
{% block content %}
<div class="page-container">
<section class="data-box">
<div class="table-card">
<table class="evaluations-table">
{{ evaluation_table_header(site, labels, show_action=false, full=true) }}
<tbody>
{{ evaluation_row(evaluation, site, labels, url_for, show_action=false, format_groups=format_groups, module_labels=module_labels, full=true) }}
</tbody>
</table>
</div>
</section>

<h2>{{ labels.evaluation_page.order_heading }}</h2>

{% if order_slots %}
<section class="data-box">
<ol class="box-list">
{% for slot in order_slots %}
<li class="box-row order-slot{% if slot.is_current %} is-current{% endif %}">
<span class="order-rank" aria-hidden="true">{{ loop.index }}</span>
<span class="order-time">{% if slot.date_label %}<a href="{{ url_for(slot.date_target) }}">{{ slot.date_label }}</a> {% endif %}{{ slot.time_range }}</span>
<span class="order-classes">
{% for item in slot.classes %}<span class="order-class{% if item.is_current %} is-current{% endif %}">{{ item.label }}</span>{% endfor %}
{% if slot.is_current %}<span class="order-note">{{ labels.evaluation_page.order_own_class }}</span>{% endif %}
{% for note in slot.notes %}<span class="order-note">{{ note }}</span>{% endfor %}
</span>
</li>
{% endfor %}
</ol>
</section>
{% else %}
<div class="empty-state-message">{{ labels.evaluation_page.no_other_class }}</div>
{% endif %}
</div>
{% endblock %}
