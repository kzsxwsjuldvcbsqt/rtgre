{% from "_icons.html.j2" import icon %}
{% macro evaluation_table_header(site, labels, show_action=true, full=false) %}
<colgroup>
<col class="col-date">
<col class="col-time">
<col class="col-category">
<col class="col-module">
<col class="col-module-name">
{% if full %}
<col class="col-rooms">
{% if site.teachers.display_mode != "hidden" %}<col class="col-teachers">{% endif %}
<col class="col-groups">
{% endif %}
{% if show_action %}
<col class="col-action">
{% endif %}
</colgroup>
<thead>
<tr>
<th class="col-date">{{ labels.fields.date }}</th>
<th class="col-time">{{ labels.fields.time }}</th>
<th class="col-category">{{ labels.fields.category }}</th>
<th class="col-module">{{ labels.fields.module }}</th>
<th class="col-module-name">{{ labels.fields.module_name }}</th>
{% if full %}
<th class="col-rooms">{{ labels.fields.rooms }}</th>
{% if site.teachers.display_mode != "hidden" %}<th class="col-teachers">{{ labels.fields.teachers }}</th>{% endif %}
<th class="col-groups">{{ labels.fields.groups }}</th>
{% endif %}
{% if show_action %}
<th class="col-action">{{ labels.fields.compare }}</th>
{% endif %}
</tr>
</thead>
{% endmacro %}

{% macro evaluation_row(ev, site, labels, url_for, show_action=true, format_groups=None, module_labels={}, full=false) %}
<tr class="eval-row"
    data-category="{{ ev.category_id }}"
    data-module="{{ ev.module_code }}"
    data-end-timestamp="{{ ev.end_dt.timestamp() | int }}"
    data-past="{{ 'true' if ev.is_past else 'false' }}"
>
<td class="col-date" data-label="{{ labels.fields.date }}">
{{ ev.date_formatted }}
</td>
<td class="col-time" data-label="{{ labels.fields.time }}">
{{ ev.time_range }}
<span class="badge-past"{% if not ev.is_past %} hidden{% endif %}>{{ labels.class_page.past_badge }}</span>
</td>
<td class="col-category" data-label="{{ labels.fields.category }}">
<span class="category-badge cat-{{ ev.category_id }}">{{ ev.category_label }}</span>
</td>
<td class="col-module" data-label="{{ labels.fields.module }}">{{ ev.module_code }}</td>
<td class="col-module-name" data-label="{{ labels.fields.module_name }}">{{ module_labels.get(ev.module_code, "") }}</td>
{% if full %}
<td class="col-rooms" data-label="{{ labels.fields.rooms }}">
{% for room in ev.rooms %}<span class="room-tag">{{ room }}</span>{% if not loop.last %}{{ labels.list_separator }}{% endif %}{% endfor %}
</td>
{% if site.teachers.display_mode != "hidden" %}
<td class="col-teachers" data-label="{{ labels.fields.teachers }}">
{% if ev.teachers %}
{% for teacher in ev.teachers %}<span class="room-tag">{{ teacher }}</span>{% if not loop.last %}{{ labels.list_separator }}{% endif %}{% endfor %}
{% elif ev.staff_markers %}
{% for marker in ev.staff_markers %}<span class="room-tag">{{ marker }}</span>{% if not loop.last %}{{ labels.list_separator }}{% endif %}{% endfor %}
{% else %}
<span>{{ labels.empty_value }}</span>
{% endif %}
</td>
{% endif %}
<td class="col-groups" data-label="{{ labels.fields.groups }}">
{% set grp_list = format_groups(ev.groups) if format_groups else ev.groups %}
{% for group in grp_list %}<span class="room-tag">{{ group }}</span>{% if not loop.last %}{{ labels.list_separator }}{% endif %}{% endfor %}
</td>
{% endif %}
{% if show_action %}
<td class="col-action" data-label="">
{% set detail_target = 'classes/' ~ ev.class_id ~ '/evaluations/' ~ ev.occurrence_id ~ '.html' %}
<a href="{{ url_for(detail_target) }}" class="detail-link">{{ labels.class_page.detail_link }}{{ icon('chevron-right', url_for, site.icons, 'icon-sm') }}</a>
</td>
{% endif %}
</tr>
{% endmacro %}
